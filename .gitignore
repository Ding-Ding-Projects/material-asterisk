# git ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.
# For a project mostly in C, the following would be a good set of
# exclude patterns (uncomment them if you want to use them):
# *.[oa]
# *~

# See .gitignore in subdirectories for more ignored files

*~
*.[oadi]
*.gz
*.ii
*.oo
*.eo
*.so
*.exports
*.moduleinfo
*.makeopts
*.makedeps
.lastclean
/.pc
aclocal.m4
autom4te.cache
config.log
config.status
defaults.h
makeopts
makeopts.embed_rules
menuselect-tree
*.sha1
*.pyc
*.gcno
*.gcda
latex
doxygen.log
out/
*.orig
tests/CI/output
.develvars
.devcontainer/
.claude/
.clangd
.clang-format
.clang-tidy
compile_commands.json
.cache/

# Ding PBX Console generated dependencies and build outputs
/console/node_modules
/console/dist/
/console/dist-electron/
/console/site/dist/
/console/site/release-manifest.local.json
/console/tsconfig.tsbuildinfo
/console/resources/asterisk-wsl-rootfs.tar
/console/resources/asterisk-wsl-rootfs.json
/console/resources/forge/gh.exe
/console/resources/school-mode-provenance.json

# Compiled output emitted beside sources. A stray typecheck with the wrong
# settings drops these into the source tree, where they shadow the real
# modules and get committed as though they were written by hand.
console/control-plane/*.js
console/control-plane/*.d.ts

# Built installer images live in console/dist/, which is already ignored above and
# really does reach gigabytes. console/release/ is NOT build output: it is where the
# completeness inventory's evidenceTemplates point every capture and interaction
# record, so ignoring it made all 251 required evidence artifacts uncommittable while
# protecting against installer images that are never written there. Verified after a
# full build: console/dist/ held 1.9 GB and console/release/ held 192 KB of evidence.
ralph/logs/

# console/inventories/ui-smoke/interaction-manifest.json is a 160 MB generated
# census that GitHub's 100 MB per-file limit refuses outright, so every dew of
# main was rejected from 2026-08-26 until it was stripped from history. Nothing
# in the tree reads it, and its own generatedBy field names a script
# (console/scripts/generate-ui-smoke-manifest.mjs) that is not in the repository,
# so it cannot be regenerated here either. Regenerate it locally when that
# generator lands; route any future copy through the Cheap LFS/cloud transfer
# path rather than committing it to ordinary Git.
console/inventories/ui-smoke/interaction-manifest.json

# Generated compiler caches only; preserve adjacent test evidence.
/.test-tmp/node-compile-cache/
/.test-tmp/tsx-1000/
/.tmp/tsx-1000/
/test-tmp/node-compile-cache/
/test-tmp/tsx-1000/
